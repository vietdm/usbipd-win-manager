<!-- Light color tokens. Keys must match Colors.Dark.xaml exactly (ThemeManager swaps the two at runtime). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <Color x:Key="Color.Window">#F8FAFC</Color>
    <Color x:Key="Color.TitleBar">#F1F5F9</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.SurfaceAlt">#F1F5F9</Color>
    <Color x:Key="Color.SurfaceHover">#E2E8F0</Color>
    <Color x:Key="Color.SurfacePressed">#CBD5E1</Color>
    <Color x:Key="Color.Console">#F1F5F9</Color>
    <Color x:Key="Color.Border">#E2E8F0</Color>
    <Color x:Key="Color.BorderStrong">#64748B</Color>
    <Color x:Key="Color.WindowBorder">#CBD5E1</Color>

    <!-- Text -->
    <Color x:Key="Color.Text">#0F172A</Color>
    <Color x:Key="Color.TextMuted">#475569</Color>
    <Color x:Key="Color.TextDisabled">#94A3B8</Color>

    <!-- Accent (run green) and danger -->
    <Color x:Key="Color.Accent">#15803D</Color>
    <Color x:Key="Color.AccentHover">#166534</Color>
    <Color x:Key="Color.AccentPressed">#14532D</Color>
    <Color x:Key="Color.OnAccent">#FFFFFF</Color>
    <Color x:Key="Color.AccentText">#15803D</Color>
    <Color x:Key="Color.Danger">#DC2626</Color>
    <Color x:Key="Color.DangerHover">#B91C1C</Color>
    <Color x:Key="Color.OnDanger">#FFFFFF</Color>
    <Color x:Key="Color.FocusRing">#1D4ED8</Color>
    <Color x:Key="Color.Selection">#DBEAFE</Color>

    <!-- Console levels -->
    <Color x:Key="Color.Log.Info">#0F172A</Color>
    <Color x:Key="Color.Log.Success">#166534</Color>
    <Color x:Key="Color.Log.Warning">#92400E</Color>
    <Color x:Key="Color.Log.Error">#B91C1C</Color>
    <Color x:Key="Color.Log.Command">#1D4ED8</Color>
    <Color x:Key="Color.Log.Timestamp">#475569</Color>

    <!-- Banners and badges -->
    <Color x:Key="Color.Banner.Error.Background">#FEE2E2</Color>
    <Color x:Key="Color.Banner.Error.Foreground">#991B1B</Color>
    <Color x:Key="Color.Banner.Error.Border">#FCA5A5</Color>
    <Color x:Key="Color.Banner.Warning.Background">#FEF9C3</Color>
    <Color x:Key="Color.Banner.Warning.Foreground">#854D0E</Color>
    <Color x:Key="Color.Banner.Warning.Border">#FDE047</Color>
    <Color x:Key="Color.Badge.Neutral.Background">#E2E8F0</Color>
    <Color x:Key="Color.Badge.Neutral.Foreground">#334155</Color>
    <Color x:Key="Color.Badge.Shared.Background">#DBEAFE</Color>
    <Color x:Key="Color.Badge.Shared.Foreground">#1D4ED8</Color>
    <Color x:Key="Color.Badge.Attached.Background">#DCFCE7</Color>
    <Color x:Key="Color.Badge.Attached.Foreground">#166534</Color>
    <Color x:Key="Color.Badge.Disconnected.Background">#FEF3C7</Color>
    <Color x:Key="Color.Badge.Disconnected.Foreground">#854D0E</Color>

    <!-- Controls -->
    <Color x:Key="Color.Switch.Off.Track">#E2E8F0</Color>
    <Color x:Key="Color.Switch.Off.Border">#64748B</Color>
    <Color x:Key="Color.Switch.Off.Thumb">#475569</Color>
    <Color x:Key="Color.Switch.On.Thumb">#FFFFFF</Color>
    <Color x:Key="Color.Scrollbar.Thumb">#94A3B8</Color>
    <Color x:Key="Color.Scrollbar.ThumbHover">#64748B</Color>
    <Color x:Key="Color.Tooltip.Background">#0F172A</Color>
    <Color x:Key="Color.Tooltip.Foreground">#F8FAFC</Color>
    <Color x:Key="Color.Tooltip.Border">#0F172A</Color>
    <Color x:Key="Color.Caption.Hover">#E2E8F0</Color>
    <Color x:Key="Color.Caption.CloseHover">#C42B1C</Color>
    <Color x:Key="Color.Caption.OnClose">#FFFFFF</Color>
    <Color x:Key="Color.Overlay">#B3F8FAFC</Color>
    <Color x:Key="Color.Shadow">#33000000</Color>

    <!-- Brushes (views reference these through DynamicResource) -->
    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}" />
    <SolidColorBrush x:Key="Brush.TitleBar" Color="{StaticResource Color.TitleBar}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.SurfacePressed" Color="{StaticResource Color.SurfacePressed}" />
    <SolidColorBrush x:Key="Brush.Console" Color="{StaticResource Color.Console}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.WindowBorder" Color="{StaticResource Color.WindowBorder}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.AccentPressed}" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="{StaticResource Color.AccentText}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerHover" Color="{StaticResource Color.DangerHover}" />
    <SolidColorBrush x:Key="Brush.OnDanger" Color="{StaticResource Color.OnDanger}" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="{StaticResource Color.FocusRing}" />
    <SolidColorBrush x:Key="Brush.Selection" Color="{StaticResource Color.Selection}" />
    <SolidColorBrush x:Key="Brush.Log.Info" Color="{StaticResource Color.Log.Info}" />
    <SolidColorBrush x:Key="Brush.Log.Success" Color="{StaticResource Color.Log.Success}" />
    <SolidColorBrush x:Key="Brush.Log.Warning" Color="{StaticResource Color.Log.Warning}" />
    <SolidColorBrush x:Key="Brush.Log.Error" Color="{StaticResource Color.Log.Error}" />
    <SolidColorBrush x:Key="Brush.Log.Command" Color="{StaticResource Color.Log.Command}" />
    <SolidColorBrush x:Key="Brush.Log.Timestamp" Color="{StaticResource Color.Log.Timestamp}" />
    <SolidColorBrush x:Key="Brush.Banner.Error.Background" Color="{StaticResource Color.Banner.Error.Background}" />
    <SolidColorBrush x:Key="Brush.Banner.Error.Foreground" Color="{StaticResource Color.Banner.Error.Foreground}" />
    <SolidColorBrush x:Key="Brush.Banner.Error.Border" Color="{StaticResource Color.Banner.Error.Border}" />
    <SolidColorBrush x:Key="Brush.Banner.Warning.Background" Color="{StaticResource Color.Banner.Warning.Background}" />
    <SolidColorBrush x:Key="Brush.Banner.Warning.Foreground" Color="{StaticResource Color.Banner.Warning.Foreground}" />
    <SolidColorBrush x:Key="Brush.Banner.Warning.Border" Color="{StaticResource Color.Banner.Warning.Border}" />
    <SolidColorBrush x:Key="Brush.Badge.Neutral.Background" Color="{StaticResource Color.Badge.Neutral.Background}" />
    <SolidColorBrush x:Key="Brush.Badge.Neutral.Foreground" Color="{StaticResource Color.Badge.Neutral.Foreground}" />
    <SolidColorBrush x:Key="Brush.Badge.Shared.Background" Color="{StaticResource Color.Badge.Shared.Background}" />
    <SolidColorBrush x:Key="Brush.Badge.Shared.Foreground" Color="{StaticResource Color.Badge.Shared.Foreground}" />
    <SolidColorBrush x:Key="Brush.Badge.Attached.Background" Color="{StaticResource Color.Badge.Attached.Background}" />
    <SolidColorBrush x:Key="Brush.Badge.Attached.Foreground" Color="{StaticResource Color.Badge.Attached.Foreground}" />
    <SolidColorBrush x:Key="Brush.Badge.Disconnected.Background" Color="{StaticResource Color.Badge.Disconnected.Background}" />
    <SolidColorBrush x:Key="Brush.Badge.Disconnected.Foreground" Color="{StaticResource Color.Badge.Disconnected.Foreground}" />
    <SolidColorBrush x:Key="Brush.Switch.Off.Track" Color="{StaticResource Color.Switch.Off.Track}" />
    <SolidColorBrush x:Key="Brush.Switch.Off.Border" Color="{StaticResource Color.Switch.Off.Border}" />
    <SolidColorBrush x:Key="Brush.Switch.Off.Thumb" Color="{StaticResource Color.Switch.Off.Thumb}" />
    <SolidColorBrush x:Key="Brush.Switch.On.Thumb" Color="{StaticResource Color.Switch.On.Thumb}" />
    <SolidColorBrush x:Key="Brush.Scrollbar.Thumb" Color="{StaticResource Color.Scrollbar.Thumb}" />
    <SolidColorBrush x:Key="Brush.Scrollbar.ThumbHover" Color="{StaticResource Color.Scrollbar.ThumbHover}" />
    <SolidColorBrush x:Key="Brush.Tooltip.Background" Color="{StaticResource Color.Tooltip.Background}" />
    <SolidColorBrush x:Key="Brush.Tooltip.Foreground" Color="{StaticResource Color.Tooltip.Foreground}" />
    <SolidColorBrush x:Key="Brush.Tooltip.Border" Color="{StaticResource Color.Tooltip.Border}" />
    <SolidColorBrush x:Key="Brush.Caption.Hover" Color="{StaticResource Color.Caption.Hover}" />
    <SolidColorBrush x:Key="Brush.Caption.CloseHover" Color="{StaticResource Color.Caption.CloseHover}" />
    <SolidColorBrush x:Key="Brush.Caption.OnClose" Color="{StaticResource Color.Caption.OnClose}" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="{StaticResource Color.Overlay}" />
    <SolidColorBrush x:Key="Brush.Shadow" Color="{StaticResource Color.Shadow}" />
</ResourceDictionary>
