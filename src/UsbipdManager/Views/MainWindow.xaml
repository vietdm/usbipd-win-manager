<Window x:Class="UsbipdManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:UsbipdManager.Controls"
        xmlns:vm="clr-namespace:UsbipdManager.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="USBIPD Manager"
        Icon="pack://application:,,,/UsbipdManager;component/Assets/app.ico"
        Width="600" Height="700"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource Window.Chrome}"
        ui:UiChrome.ShowMinMax="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Content ===== -->
        <Grid Margin="16,16,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="160" />
                <RowDefinition Height="214" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Banners -->
            <StackPanel Grid.Row="0">
                <Border Margin="{DynamicResource Space.Stack}" Padding="12,10" CornerRadius="{DynamicResource Radius.Medium}" BorderThickness="1"
                        Background="{DynamicResource Brush.Banner.Error.Background}" BorderBrush="{DynamicResource Brush.Banner.Error.Border}"
                        Visibility="{Binding IsUnsupported, Converter={StaticResource Conv.BoolToVisibility}}"
                        AutomationProperties.LiveSetting="Assertive">
                    <DockPanel>
                        <ui:IconView DockPanel.Dock="Left" Geometry="{DynamicResource Icon.Error}" Width="18" Height="18" Margin="0,0,10,0"
                                     VerticalAlignment="Top" Foreground="{DynamicResource Brush.Banner.Error.Foreground}" />
                        <TextBlock Style="{DynamicResource Text.Body}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Banner.Error.Foreground}"
                                   Text="WSL is not installed on this machine. USBIPD Manager is not supported." />
                    </DockPanel>
                </Border>
                <Border Margin="{DynamicResource Space.Stack}" Padding="12,10" CornerRadius="{DynamicResource Radius.Medium}" BorderThickness="1"
                        Background="{DynamicResource Brush.Banner.Warning.Background}" BorderBrush="{DynamicResource Brush.Banner.Warning.Border}"
                        Visibility="{Binding IsUsbipdNotReady, Converter={StaticResource Conv.BoolToVisibility}}"
                        AutomationProperties.LiveSetting="Polite">
                    <DockPanel>
                        <ui:IconView DockPanel.Dock="Left" Geometry="{DynamicResource Icon.Warning}" Width="18" Height="18" Margin="0,0,10,0"
                                     VerticalAlignment="Top" Foreground="{DynamicResource Brush.Banner.Warning.Foreground}" />
                        <TextBlock Style="{DynamicResource Text.Body}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Banner.Warning.Foreground}"
                                   Text="{Binding UsbipdWarningText}" />
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- Console -->
            <Border Grid.Row="1" Style="{DynamicResource Card}" Margin="{DynamicResource Space.Stack}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="12,4,6,4" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Style="{DynamicResource Text.Section}" Text="Console" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Style="{DynamicResource Button.Icon}" Command="{Binding Console.ClearCommand}"
                                AutomationProperties.Name="Clear console" ToolTip="Clear console">
                            <ui:IconView Geometry="{DynamicResource Icon.Trash}" />
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{DynamicResource Button.Icon}" Command="{Binding Console.CopyCommand}" Margin="0,0,2,0"
                                AutomationProperties.Name="Copy console text" ToolTip="Copy all console text">
                            <ui:IconView Geometry="{DynamicResource Icon.Copy}" />
                        </Button>
                    </DockPanel>
                    <Border Grid.Row="1" Background="{DynamicResource Brush.Console}" CornerRadius="0,0,8,8"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                        <Grid>
                            <ListBox x:Name="ConsoleList" ItemsSource="{Binding Console.Lines}" Padding="0,4"
                                     SelectionMode="Extended" ItemContainerStyle="{DynamicResource ListBoxItem.Console}"
                                     AutomationProperties.Name="Console output">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LogLine}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{DynamicResource Text.Mono}" Text="{Binding Time}" Margin="0,0,10,0"
                                                       Foreground="{DynamicResource Brush.Log.Timestamp}" TextWrapping="NoWrap" />
                                            <TextBlock x:Name="TagText" Grid.Column="1" Style="{DynamicResource Text.Mono}" Text="{Binding Tag}"
                                                       FontWeight="Bold" TextWrapping="NoWrap" Foreground="{DynamicResource Brush.Log.Info}" />
                                            <TextBlock x:Name="MessageText" Grid.Column="2" Style="{DynamicResource Text.Mono}" Text="{Binding Message}"
                                                       Foreground="{DynamicResource Brush.Log.Info}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="Success">
                                                <Setter TargetName="TagText" Property="Foreground" Value="{DynamicResource Brush.Log.Success}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                <Setter TargetName="TagText" Property="Foreground" Value="{DynamicResource Brush.Log.Warning}" />
                                                <Setter TargetName="MessageText" Property="Foreground" Value="{DynamicResource Brush.Log.Warning}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                                <Setter TargetName="TagText" Property="Foreground" Value="{DynamicResource Brush.Log.Error}" />
                                                <Setter TargetName="MessageText" Property="Foreground" Value="{DynamicResource Brush.Log.Error}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Command">
                                                <Setter TargetName="TagText" Property="Foreground" Value="{DynamicResource Brush.Log.Command}" />
                                                <Setter TargetName="MessageText" Property="Foreground" Value="{DynamicResource Brush.Log.Command}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button x:Name="JumpToLatestButton" Visibility="Collapsed" Style="{DynamicResource Button.Secondary}"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,8" Padding="10,2" MinHeight="28"
                                    FontSize="{DynamicResource FontSize.Caption}" Click="OnJumpToLatest"
                                    AutomationProperties.Name="Jump to the newest console line">
                                <StackPanel Orientation="Horizontal">
                                    <ui:IconView Geometry="{DynamicResource Icon.ArrowDown}" Width="12" Height="12" Margin="0,0,6,0" />
                                    <TextBlock Text="Newest" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Devices -->
            <Border Grid.Row="2" Style="{DynamicResource Card}" Margin="{DynamicResource Space.Stack}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="12,4,6,4" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Style="{DynamicResource Text.Section}" Text="Devices" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Left" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" Margin="8,1,0,0"
                                   Text="Switch on the devices to move between Windows and WSL2" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <Button DockPanel.Dock="Right" Style="{DynamicResource Button.Icon}" Command="{Binding RefreshDevicesCommand}"
                                AutomationProperties.Name="Refresh devices" ToolTip="Refresh devices">
                            <ui:IconView Geometry="{DynamicResource Icon.Refresh}" />
                        </Button>
                    </DockPanel>
                    <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                          Visibility="{Binding HasDevices, Converter={StaticResource Conv.BoolToVisibility}}">
                                <ItemsControl ItemsSource="{Binding Devices}" Focusable="False" AutomationProperties.Name="USB devices">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DeviceItemViewModel}">
                                            <Border Padding="12,8,10,8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="72" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <TextBlock Style="{DynamicResource Text.Body}" FontWeight="SemiBold" Text="{Binding Description}"
                                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                            <TextBlock Style="{DynamicResource Text.Mono}" FontSize="{DynamicResource FontSize.Caption}"
                                                                       Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding BusIdText}" />
                                                            <TextBlock Style="{DynamicResource Text.Mono}" FontSize="{DynamicResource FontSize.Caption}"
                                                                       Foreground="{DynamicResource Brush.TextMuted}" Text="  |  " />
                                                            <TextBlock Style="{DynamicResource Text.Mono}" FontSize="{DynamicResource FontSize.Caption}"
                                                                       Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding VidPidText}" />
                                                            <TextBlock Style="{DynamicResource Text.Caption}" Margin="10,0,0,0" Text="Input device"
                                                                       Visibility="{Binding IsInputLike, Converter={StaticResource Conv.BoolToVisibility}}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Border x:Name="Badge" Grid.Column="1" Style="{DynamicResource Badge}" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding StateText}" />
                                                    </Border>
                                                    <CheckBox Grid.Column="2" Style="{DynamicResource ToggleSwitch}" HorizontalAlignment="Right"
                                                              IsChecked="{Binding IsManaged, Mode=OneWay}" Command="{Binding ToggleCommand}"
                                                              AutomationProperties.Name="{Binding ToggleAutomationName}" ToolTip="{Binding ToggleToolTip}"
                                                              Visibility="{Binding IsConnected, Converter={StaticResource Conv.BoolToVisibility}}" />
                                                    <Button Grid.Column="2" Style="{DynamicResource Button.Subtle}" Content="Forget" HorizontalAlignment="Right"
                                                            Command="{Binding ForgetCommand}" AutomationProperties.Name="{Binding ForgetAutomationName}"
                                                            ToolTip="Remove this disconnected device from the managed list"
                                                            Visibility="{Binding IsDisconnected, Converter={StaticResource Conv.BoolToVisibility}}" />
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding BadgeKind}" Value="Shared">
                                                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Badge.Shared.Background}" />
                                                    <Setter TargetName="Badge" Property="TextElement.Foreground" Value="{DynamicResource Brush.Badge.Shared.Foreground}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding BadgeKind}" Value="Attached">
                                                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Badge.Attached.Background}" />
                                                    <Setter TargetName="Badge" Property="TextElement.Foreground" Value="{DynamicResource Brush.Badge.Attached.Foreground}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding BadgeKind}" Value="Disconnected">
                                                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Badge.Disconnected.Background}" />
                                                    <Setter TargetName="Badge" Property="TextElement.Foreground" Value="{DynamicResource Brush.Badge.Disconnected.Foreground}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0"
                                        Visibility="{Binding HasDevices, Converter={StaticResource Conv.InverseBoolToVisibility}}">
                                <ui:IconView Geometry="{DynamicResource Icon.Usb}" Width="28" Height="28" Margin="0,0,0,8"
                                             Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Style="{DynamicResource Text.Muted}" Text="{Binding EmptyStateText}" TextAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Status line -->
            <Grid Grid.Row="3" Margin="{DynamicResource Space.StackSmall}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Padding="10,4" CornerRadius="{DynamicResource Radius.Medium}" Background="{DynamicResource Brush.SurfaceAlt}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <ui:IconView Geometry="{DynamicResource Icon.Windows}" IsFilled="True" Width="14" Height="14" Margin="0,0,8,0"
                                     Visibility="{Binding IsWindowsActive, Converter={StaticResource Conv.BoolToVisibility}}" />
                        <ui:IconView Geometry="{DynamicResource Icon.Terminal}" Width="14" Height="14" Margin="0,0,8,0"
                                     Visibility="{Binding IsWslActive, Converter={StaticResource Conv.BoolToVisibility}}" />
                        <TextBlock Style="{DynamicResource Text.Section}" Text="{Binding ModeText}" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
                <TextBlock Grid.Column="1" Style="{DynamicResource Text.Caption}" Text="{Binding StatusDetail}" Margin="12,0"
                           VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusDetail}" />
                <TextBlock Grid.Column="2" Style="{DynamicResource Text.Caption}" Text="{Binding BusyText}" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text}" AutomationProperties.LiveSetting="Polite"
                           Visibility="{Binding IsBusy, Converter={StaticResource Conv.BoolToVisibility}}" />
                <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0" Style="{DynamicResource Progress.Busy}"
                             AutomationProperties.Name="Operation in progress"
                             Visibility="{Binding IsBusy, Converter={StaticResource Conv.BoolToVisibility}}" />
            </Grid>

            <!-- Actions -->
            <UniformGrid Grid.Row="4" Columns="3">
                <Button Style="{DynamicResource Button.Mode}" Margin="0,0,6,0" Content="Init" Command="{Binding InitCommand}"
                        ui:UiProps.Icon="{DynamicResource Icon.Refresh}"
                        ToolTip="Re-check the environment and fix what is missing: install usbipd-win, start its service, share managed devices" />
                <Button Style="{DynamicResource Button.Mode}" Margin="3,0" Content="Windows" Command="{Binding WindowsCommand}"
                        ui:UiProps.Icon="{DynamicResource Icon.Windows}" ui:UiProps.IconFilled="True"
                        ui:UiProps.IsActive="{Binding IsWindowsActive}"
                        AutomationProperties.HelpText="Move the managed devices to Windows"
                        ToolTip="Move the managed devices to Windows" ToolTipService.ShowOnDisabled="True" />
                <Button Style="{DynamicResource Button.Mode}" Margin="6,0,0,0" Content="WSL2" Command="{Binding WslCommand}"
                        ui:UiProps.Icon="{DynamicResource Icon.Terminal}"
                        ui:UiProps.IsActive="{Binding IsWslActive}"
                        AutomationProperties.HelpText="Move the managed devices to WSL2"
                        ToolTip="Move the managed devices to WSL2" ToolTipService.ShowOnDisabled="True" />
            </UniformGrid>
        </Grid>

        <!-- ===== Footer ===== -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Background="{DynamicResource Brush.TitleBar}"
                Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <Button Style="{DynamicResource Button.Icon}" HorizontalAlignment="Left" Command="{Binding SettingsCommand}"
                        AutomationProperties.Name="Settings" ToolTip="Settings">
                    <ui:IconView Geometry="{DynamicResource Icon.Gear}" Width="18" Height="18" StrokeThickness="1.8" />
                </Button>
                <TextBlock Grid.Column="1" Style="{DynamicResource Text.Caption}" Text="{Binding Copyright}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap" />
                <Button Grid.Column="2" Style="{DynamicResource Button.Subtle}" HorizontalAlignment="Right" Command="{Binding HelpCommand}"
                        AutomationProperties.Name="Help" ToolTip="Where to report issues">
                    <StackPanel Orientation="Horizontal">
                        <ui:IconView Geometry="{DynamicResource Icon.Help}" Width="16" Height="16" Margin="0,0,6,0"
                                     Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock Text="Help" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ===== Exit overlay ===== -->
        <Grid Grid.RowSpan="2" Background="{DynamicResource Brush.Overlay}"
              Visibility="{Binding IsExiting, Converter={StaticResource Conv.BoolToVisibility}}">
            <Border Style="{DynamicResource Card}" Padding="20,16" HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.Section}" Text="{Binding BusyText}" AutomationProperties.LiveSetting="Assertive" />
                    <TextBlock Style="{DynamicResource Text.Caption}" Margin="0,4,0,12" Text="USBIPD Manager will close when this is done." />
                    <ProgressBar Style="{DynamicResource Progress.Busy}" AutomationProperties.Name="Exiting" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
