<Window x:Class="UsbipdManager.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:UsbipdManager.Controls"
        Title="USBIPD Manager"
        Icon="pack://application:,,,/UsbipdManager;component/Assets/app.ico"
        Width="420"
        SizeToContent="Height"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource Window.Chrome}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="20,20,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:IconView x:Name="KindIcon" Width="24" Height="24" Margin="0,0,14,0" VerticalAlignment="Top"
                         Geometry="{DynamicResource Icon.Info}" Foreground="{DynamicResource Brush.Log.Command}" />
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="HeadingText" Style="{DynamicResource Text.Subtitle}" Margin="0,1,0,6" />
                <TextBlock x:Name="MessageText" Style="{DynamicResource Text.Body}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource Brush.TitleBar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SecondaryButton" MinWidth="88" Margin="0,0,8,0" IsCancel="True" Click="OnSecondary" Visibility="Collapsed" />
                <Button x:Name="PrimaryButton" MinWidth="88" Style="{DynamicResource Button.Primary}" IsDefault="True" Click="OnPrimary" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
